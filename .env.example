# development | test | production. Unset means production.
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/impressa
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# sk_test_... on staging, sk_live_... on production
PAYSTACK_SECRET_KEY=

# Required in production -----------------------------------------------
# Browser origins allowed to call the API (website and admin panel), comma-separated
CORS_ORIGINS=https://impressa.ng,https://admin.impressa.ng
# Website base URL, used for password reset links
APP_URL=https://impressa.ng
# From resend.com, with the sending domain verified
RESEND_API_KEY=
EMAIL_FROM=Impressa <no-reply@impressa.ng>

# Optional ---------------------------------------------------------------
# Error tracking; leave empty to disable
SENTRY_DSN=
# Proxies in front of the app (Render's load balancer is 1)
TRUST_PROXY=1

# Mobile app ---------------------------------------------------------------
# Raise to force older app versions to update (blocking screen in the app)
MIN_APP_VERSION_IOS=1.0.0
MIN_APP_VERSION_ANDROID=1.0.0
# App Store link, once the app is live
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.impressa.app
# Only needed if "enhanced push security" is enabled on the Expo project
EXPO_ACCESS_TOKEN=
